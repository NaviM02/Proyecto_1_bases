ty \&quot;egreso\&quot; as egreso {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  ingreso_id : integer &lt;&lt;FK&gt;&gt;\n  paciente_id : integer &lt;&lt;FK&gt;&gt;\n  hospital_id : integer &lt;&lt;FK&gt;&gt;\n  unidad_medica_id : integer &lt;&lt;FK&gt;&gt;\n  servicio_medico_id : integer &lt;&lt;FK&gt;&gt;\n  medico_asignado_id : integer &lt;&lt;FK&gt;&gt;\n  recurso_asistencial_id : integer &lt;&lt;FK&gt;&gt;\n  fecha_hora : timestamp\n  diagnostico_principal : text\n  diagnosticos_secundarios : text\n  motivo : text\n  codigo_egreso : varchar(20)\n  sin_consentimiento_medico : boolean\n  motivo_sin_consentimiento : text\n  dias_hospitalizado : integer\n  operaciones_intervenciones : text\n  codigo_traslado : varchar(30)\n  referido_a : text\n}\n\nentity \&quot;traslado\&quot; as traslado {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  paciente_id : integer &lt;&lt;FK&gt;&gt;\n  medico_indica_id : integer &lt;&lt;FK&gt;&gt;\n  hospital_origen_id : integer &lt;&lt;FK&gt;&gt;\n  unidad_origen_id : integer &lt;&lt;FK&gt;&gt;\n  servicio_origen_id : integer &lt;&lt;FK&gt;&gt;\n  hospital_destino_id : integer &lt;&lt;FK&gt;&gt;\n  unidad_destino_id : integer &lt;&lt;FK&gt;&gt;\n  servicio_destino_id : integer &lt;&lt;FK&gt;&gt;\n  fecha_hora : timestamp\n  tipo_traslado : varchar(10)\n  observaciones : text\n}\n\nentity \&quot;cita\&quot; as cita {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  paciente_id : integer &lt;&lt;FK&gt;&gt;\n  hospital_id : integer &lt;&lt;FK&gt;&gt;\n  clinica_id : integer &lt;&lt;FK&gt;&gt;\n  medico_id : integer &lt;&lt;FK&gt;&gt;\n  fecha_hora : timestamp\n  costo : numeric(12,2)\n  tipo_cita : varchar(20)\n  estado : varchar(20)\n  fecha_cancelacion : timestamp\n  motivo_cancelacion : text\n}\n\nentity \&quot;consulta\&quot; as consulta {\n  * id : integer &lt;&lt;PK&gt;&gt;\n  --\n  cita_id : integer &lt;&lt;FK&gt;&gt;\n  paciente_id : integer &lt;&lt;FK&gt;&gt;\n  medico_id : integer &lt;&lt;FK&gt;&gt;\n  fecha_hora : timestamp\n  dia